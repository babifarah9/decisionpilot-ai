digraph DecisionPilot {
 graph [rankdir=TB, bgcolor="#f5f7f3", pad=.4, nodesep=.4, ranksep=.5, fontname="Arial", label="DecisionPilot AI | AWS Architecture", labelloc=t, fontsize=24, fontcolor="#183b31"];
 node [shape=box, style="rounded,filled", fillcolor="white", color="#b9cec2", fontname="Arial", fontsize=13, margin=".22,.16", fontcolor="#16382d"];
 edge [color="#628674", arrowsize=.7, fontname="Arial", fontsize=10, fontcolor="#4d6c5a"];
 ui [label="USER / BROWSER\nObjective, preferences and human decision"];
 cdn [label="Amazon CloudFront\nPublic HTTPS access"];
 subgraph cluster_host {
 label="AMAZON EC2 | APPLICATION"; color="#c1d3c6"; style="rounded"; fontname="Arial"; fontcolor="#59745e";
 controller [label="Web UI + workflow controller"];
 planner [label="Strands SDK planning service\nRead-only tools; no approval or execution access",fillcolor="#e2eee3"];
 tools [label="Search and evaluation tools\nSynthetic appointment inventory"];
 gate [label="HUMAN DECISION GATE\nPrice, reason and alternatives\nPersist proposal; wait for human decision",fillcolor="#fff1d1",color="#c1a15a",penwidth=2];
 human [label="Human-only decision controller\nSession validation + explicit approve / reject",fillcolor="#fff1d1",color="#c1a15a"];
 execute [label="Idempotent execution\nApproved proposal -> simulated booking"];
 verify [label="Verification\nCompare receipt, provider, slot and price"];
 complete [label="COMPLETED\nAudit trail + estimated human minutes saved",fillcolor="#153e34",fontcolor=white];
 stop [label="REJECTED / EXPIRED\nNo booking"];
 failed [label="VERIFICATION FAILED\nNo completion claim",fillcolor="#f5e7de"];
 controller -> planner;
 planner -> tools [dir=both];
 planner -> gate [label="validated recommendation"];
 gate -> human [label="proposal shown in UI"];
 human -> execute [label="approved"];
 human -> stop [label="rejected / expired"];
 execute -> verify;
 verify -> complete [label="match"];
 verify -> failed [label="mismatch"];
 }
 model [label="Amazon Bedrock\nNova Lite",fillcolor="#e2eee3"];
 storage [shape=cylinder,label="SQLite state, audit and receipts\nEncrypted Amazon EBS volume",fillcolor="#e5ece4"];
 management [label="AWS Systems Manager + IAM\nHost administration + scoped access"];
 ui -> cdn;
 cdn -> controller;
 ui -> human [label="explicit decision",color="#b18b3a"];
 planner -> model [dir=both];
 gate -> storage [label="persist",constraint=false];
 human -> storage [constraint=false];
 execute -> storage [constraint=false];
 verify -> storage [constraint=false];
 management -> controller [style=dashed,constraint=false];
 {rank=same; model; planner;}
 {rank=same; storage; execute; stop;}
}
